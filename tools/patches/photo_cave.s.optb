@ C100 Option B: per-2x2-block nearest-palette colour dithering + palette cycling.
    .syntax unified
    .arm
base:
    .set    RESUME,      base + 0x1544c
    .set    PHOTO_PATH,  base + 0xf188
    .set    RESUME187,   base + 0x187c8
    .set    CACHE_INV,   base + 0x401ac
    .set    CACHE_CLEAN, base + 0x401b8
    .equ    PHOTO,       0x1317ac
    .equ    STRIP_BYTES, 0x13155c
    .equ    NPAL,        7
    .equ    DTAB_ADDR,     0x000bae00
    .equ    PAL_IDX_ADDR,  0x000bae10
    .equ    PALETTES_ADDR, 0x000bae14
    .equ    PHOTO43_ADDR,  0x000baec0
    .equ    STUB_ADDR,     0x000baf40

@ frame(48): 0 base, 4 stride, 8 third, 12 palbase, 16 paircount,
@            20 cptr, 24 cend, 28 half, 32 ebase, 36 parity
    .org    0xbab6c
hook:
    push    {r4-r11, lr}
    sub     r3, r0, #0x200000
    cmp     r3, #0xe00000
    bhs     hret
    ldr     r4, =PHOTO
    ldr     r6, =STRIP_BYTES
    ldr     r6, [r6]
    cmp     r6, #96
    bls     hret
    ldr     r0, [r4, #0x18]
    cmp     r1, r0
    beq     1f
    add     r0, r0, r6
    cmp     r1, r0
    bne     hret
1:  sub     sp, sp, #48
    ldr     r1, [r4, #0x18]            @ base = buffer A (always), process whole 2x alloc
    str     r1, [sp, #0]
    mov     r7, r6, lsr #5
    str     r7, [sp, #4]
    ldr     r2, =0xAAAAAAAB
    umull   r0, r3, r7, r2
    mov     r8, r3, lsr #1
    str     r8, [sp, #8]
    ldr     r4, =PAL_IDX_ADDR
    ldrb    r0, [r4]
    cmp     r0, #NPAL
    movhs   r0, #0
    ldr     r4, =PALETTES_ADDR
    mov     r2, #18
    mla     r4, r0, r2, r4
    str     r4, [sp, #12]
    ldr     r0, [sp, #0]
    mov     r1, r6, lsl #1             @ invalidate 2*STRIP_BYTES
    mov     lr, pc
    b       CACHE_INV
    mov     r0, #32                    @ 32 row-pairs (64 rows = whole alloc)
    str     r0, [sp, #16]
    ldr     r0, [sp, #0]
    str     r0, [sp, #32]
    mov     r0, #0
    str     r0, [sp, #36]
pairloop:
    mov     r0, #0
    str     r0, [sp, #28]             @ half = 0 (left)
halfloop:
    ldr     r9, [sp, #32]             @ ebase
    ldr     r8, [sp, #8]              @ third
    ldr     r12, [sp, #28]            @ half
    cmp     r12, #0
    beq     setleft
    ldr     r1, [sp, #4]
    add     r5, r9, r1                @ right: cptr = ebase+stride
    b       setend
setleft:
    add     r5, r9, r8, lsl #1        @ left: cptr = ebase+2*third
setend:
    add     r6, r5, r8
    str     r5, [sp, #20]
    str     r6, [sp, #24]
blockloop:
    ldr     r5, [sp, #20]             @ cptr
    ldr     r7, [sp, #4]              @ stride
    ldr     r8, [sp, #8]              @ third
    ldr     r12, [sp, #28]            @ half
    cmp     r12, #0
    subeq   r0, r5, r8, lsl #1        @ left eluma = cptr-2*third
    addeq   r1, r5, r7
    subeq   r1, r1, r8               @ left oluma = cptr+stride-third
    addne   r0, r5, r8               @ right eluma = cptr+third-stride
    subne   r0, r0, r7
    addne   r1, r5, r8, lsl #1       @ right oluma = cptr+2*third
    ldrb    r2, [r5]                 @ U
    ldrb    r3, [r5, #1]             @ V
    ldrb    r6, [r0]                 @ repY
    ldr     r12, [sp, #36]           @ parity
    and     r12, r12, #1
    mov     r12, r12, lsl #1
    tst     r5, #2
    orrne   r12, r12, #1
    ldr     lr, =DTAB_ADDR
    ldrsb   r12, [lr, r12]
    adds    r6, r6, r12
    movmi   r6, #0
    cmp     r6, #255
    movgt   r6, #255                 @ Yp in r6
    @ nearest-palette match: Yp=r6, U=r2, V=r3
    ldr     r12, [sp, #12]           @ pp = palbase
    mov     lr, #0                    @ joff
    mov     r7, #0                    @ bestoff
    mvn     r8, #0                    @ bestd
mloop:
    ldrb    r4, [r12], #1
    subs    r4, r6, r4
    rsbmi   r4, r4, #0
    ldrb    r0, [r12], #1
    subs    r0, r2, r0
    rsbmi   r0, r0, #0
    add     r4, r4, r0
    ldrb    r0, [r12], #1
    subs    r0, r3, r0
    rsbmi   r0, r0, #0
    add     r4, r4, r0
    cmp     r4, r8
    movlo   r8, r4
    movlo   r7, lr
    add     lr, lr, #3
    cmp     lr, #18
    blo     mloop
    ldr     r4, [sp, #12]
    add     r7, r4, r7               @ entry = palbase + bestoff
    ldrb    r4, [r7]                 @ pal Y
    ldrb    r0, [r7, #1]             @ pal U
    ldrb    r12, [r7, #2]            @ pal V
    @ recompute luma ptrs
    ldr     r5, [sp, #20]            @ cptr
    ldr     r8, [sp, #8]             @ third
    ldr     lr, [sp, #4]             @ stride
    ldr     r3, [sp, #28]            @ half
    cmp     r3, #0
    subeq   r1, r5, r8, lsl #1
    addeq   r2, r5, lr
    subeq   r2, r2, r8
    addne   r1, r5, r8
    subne   r1, r1, lr
    addne   r2, r5, r8, lsl #1
    strb    r4, [r1]
    strb    r4, [r1, #1]
    strb    r4, [r2]
    strb    r4, [r2, #1]
    strb    r0, [r5]
    strb    r12, [r5, #1]
    add     r5, r5, #2
    str     r5, [sp, #20]
    ldr     r6, [sp, #24]            @ cend
    cmp     r5, r6
    blo     blockloop
    ldr     r12, [sp, #28]
    add     r12, r12, #1
    str     r12, [sp, #28]
    cmp     r12, #2
    blt     halfloop
    ldr     r9, [sp, #32]
    ldr     r7, [sp, #4]
    add     r9, r9, r7, lsl #1       @ ebase += 2*stride
    str     r9, [sp, #32]
    ldr     r12, [sp, #36]
    add     r12, r12, #1
    str     r12, [sp, #36]
    ldr     r6, [sp, #16]
    subs    r6, r6, #1
    str     r6, [sp, #16]
    bgt     pairloop
    ldr     r0, [sp, #0]             @ cache clean [base, 32*stride)
    ldr     r7, [sp, #4]
    mov     r1, r7, lsl #6             @ clean 2*STRIP_BYTES (64*stride)
    mov     lr, pc
    b       CACHE_CLEAN
    add     sp, sp, #48
hret:
    pop     {r4-r11, lr}
    str     lr, [sp, #-4]!
    b       RESUME
    .ltorg

    .org    0xbae00
DTAB:
    .byte 0xD0, 0x10, 0x30, 0xF0      @ -48,+16,+48,-16 (2x2 bayer offsets)
    .org    0xbae10
PAL_IDX:
    .byte 6, 0, 0, 0
PALETTES:
    .byte 30, 144, 125, 115, 114, 206, 164, 72, 183, 125, 148, 69, 225, 109, 139, 255, 128, 128   @ riso6
    .byte 82, 137, 113, 235, 103, 135, 167, 76, 160, 85, 108, 177, 39, 120, 153, 39, 120, 153   @ dark_sunset
    .byte 130, 105, 196, 198, 58, 159, 164, 77, 110, 131, 174, 87, 108, 162, 138, 108, 162, 138   @ vibrant_summer
    .byte 187, 57, 166, 138, 74, 190, 106, 130, 216, 88, 196, 152, 127, 192, 90, 127, 192, 90   @ fiesta
    .byte 99, 105, 197, 89, 123, 106, 185, 114, 111, 235, 106, 132, 41, 118, 137, 41, 118, 137   @ vibrant_nature
    .byte 108, 138, 215, 83, 192, 155, 52, 187, 133, 103, 207, 108, 178, 159, 88, 178, 159, 88   @ bold_hues
    .byte 199, 145, 105, 128, 156, 89, 37, 145, 113, 193, 54, 162, 155, 65, 183, 155, 65, 183   @ refreshing

    .org    0xbaec0
photo43:
    mov     r6, #320
    mov     r7, #240
    strh    r6, [r4, #14]
    strh    r7, [r4, #16]
    mov     r0, #1
    strb    r0, [r4, #4]
    mov     r0, #1440
    strh    r0, [r4, #6]
    strh    r9, [r4, #8]
    strh    r0, [r4, #10]
    strh    r9, [r4, #12]
    b       PHOTO_PATH
    .ltorg

    .org    0xbaf40
idx_stub:
    ldr     r12, =PAL_IDX_ADDR
    ldrb    r0, [r12]
    add     r0, r0, #1
    cmp     r0, #NPAL
    movhs   r0, #0
    strb    r0, [r12]
    push    {r3, r4, r5, r6, r7, lr}
    b       RESUME187
    .ltorg
