@ C100 Option B v2: per-pixel nearest-palette colour dithering, two-pass over the
@ proven per-row register loop, + per-photo palette cycling.
    .syntax unified
    .arm
base:
    .set    RESUME,      base + 0x1544c
    .set    PHOTO_PATH,  base + 0xf188
    .set    RESUME187,   base + 0x187c8
    .set    CACHE_INV,   base + 0x401ac
    .set    CACHE_CLEAN, base + 0x401b8
    .equ    PHOTO,       0x1317ac
    .equ    STRIP_BYTES, 0x13155c
    .equ    NPAL,        7
    .equ    PAL_IDX_ADDR,  0x000bb1a0
    .equ    PALETTES_ADDR, 0x000bb1a4
    .equ    BAYER_ADDR,    0x000bb180

@ frame(16): 0 lumaend, 4 x, 8 lumaptr(spill), 12 spare
    .org    0xbab6c
hook:
    push    {r4-r11, lr}
    sub     r3, r0, #0x200000
    cmp     r3, #0xe00000
    bhs     hret
    ldr     r4, =PHOTO
    ldr     r6, =STRIP_BYTES
    ldr     r6, [r6]
    cmp     r6, #96
    bls     hret
    ldr     r0, [r4, #0x18]
    cmp     r1, r0
    beq     1f
    add     r0, r0, r6
    cmp     r1, r0
    bne     hret
1:  sub     sp, sp, #16
    ldr     r5, [r4, #0x18]            @ base = A
    mov     r7, r6, lsr #5            @ stride
    ldr     r2, =0xAAAAAAAB
    umull   r0, r3, r7, r2
    mov     r8, r3, lsr #1           @ third
    add     r5, r5, #0                @ (r5=base)
    ldr     r0, [r4, #0x18]
    mov     r6, r6, lsl #1            @ 2*STRIP
    push    {r6}                       @ keep 2*STRIP at [sp,#0] temporarily
    mov     r1, r6
    mov     lr, pc
    b       CACHE_INV
    pop     {r6}
    @ palbase
    ldr     r4, =PAL_IDX_ADDR
    ldrb    r0, [r4]
    cmp     r0, #NPAL
    movhs   r0, #0
    ldr     r4, =PALETTES_ADDR
    mov     r1, #18
    mla     r4, r0, r1, r4            @ r4 = palbase
    @ persistent: r4 palbase, r5 base, r7 stride, r8 third
    @ r11 = BAYER, r6 = 2*STRIP (end offset)
    ldr     r11, =BAYER_ADDR
    add     r6, r5, r6               @ r6 = end
    @ ================= PASS 1: luma -> palette Y =================
    mov     r9, r5                    @ rowbase
    mov     r10, #0                   @ rowidx
Lrow:
    @ luma start: even(r10&1==0) -> rowbase ; odd -> rowbase+third
    tst     r10, #1
    moveq   r0, r9
    addne   r0, r9, r8
    str     r0, [sp, #8]              @ lumaptr
    add     r0, r0, r8, lsl #1        @ lumaend = start + 2*third
    str     r0, [sp, #0]
    mov     r0, #0
    str     r0, [sp, #4]             @ x=0
Lpix:
    ldr     r12, [sp, #4]            @ x
    @ chroma address -> r0
    tst     r10, #1
    bne     Lodd
    @ even row: x<160 -> rowbase+2third + (x&~1) ; x>=160 -> (rowbase+stride) + ((x-160)&~1)
    cmp     r12, r8
    addlt   r0, r9, r8, lsl #1
    biclt   r1, r12, #1
    addlt   r0, r0, r1
    subge   r1, r12, r8
    bicge   r1, r1, #1
    addge   r0, r9, r7
    addge   r0, r0, r1
    b       Lrd
Lodd:
    @ odd row: x<160 -> (rowbase-stride)+2third + (x&~1) ; x>=160 -> rowbase + ((x-160)&~1)
    cmp     r12, r8
    sublt   r0, r9, r7
    addlt   r0, r0, r8, lsl #1
    biclt   r1, r12, #1
    addlt   r0, r0, r1
    subge   r1, r12, r8
    bicge   r1, r1, #1
    addge   r0, r9, r1
Lrd:
    ldrb    r1, [r0]                 @ U
    ldrb    r2, [r0, #1]             @ V
    ldr     r6, [sp, #8]
    ldrb    r0, [r6]                 @ Y
    @ dither Y with BAYER[(row&3)*4 + (x&3)]
    and     r3, r10, #3
    add     r3, r11, r3, lsl #2
    and     lr, r12, #3
    ldrb    lr, [r3, lr]
    sub     lr, lr, #8
    add     r0, r0, lr, lsl #2
    cmp     r0, #0
    movlt   r0, #0
    cmp     r0, #255
    movgt   r0, #255                 @ Yp=r0, U=r1, V=r2
    mov     r3, #0                    @ best off
    mvn     r12, #0                   @ bestd
    ldrb    r6, [r4, #0]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #1]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #2]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #0
    ldrb    r6, [r4, #3]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #4]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #5]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #3
    ldrb    r6, [r4, #6]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #7]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #8]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #6
    ldrb    r6, [r4, #9]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #10]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #11]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #9
    ldrb    r6, [r4, #12]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #13]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #14]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #12
    ldrb    r6, [r4, #15]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #16]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #17]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #15
    ldrb    r0, [r4, r3]             @ palette Y
    ldr     r6, [sp, #8]
    strb    r0, [r6], #1
    str     r6, [sp, #8]
    ldr     r12, [sp, #4]
    add     r12, r12, #1
    str     r12, [sp, #4]
    ldr     r0, [sp, #0]             @ lumaend
    cmp     r6, r0
    blo     Lpix
    @ next row
    add     r10, r10, #1
    add     r9, r9, r7
    add     r0, r9, r7
    cmp     r0, r6                    @ r6 still = lumaend? no -> need end. reload end:
    @ (end kept? we overwrote r6). Recompute end into a reg:
    @ use r5(base) + 2*STRIP. We lost 2*STRIP. Recompute: end = base + 64*stride
    add     r1, r5, r7, lsl #6
    cmp     r9, r1
    blo     Lrow
    @ ================= PASS 2: chroma -> palette U,V =================
    mov     r9, r5
    mov     r10, #0
Crow:
    @ chroma start: even -> rowbase+2third ; odd -> rowbase ; covers 80 samples (third bytes)
    tst     r10, #1
    addeq   r0, r9, r8, lsl #1
    movne   r0, r9
    str     r0, [sp, #8]             @ cptr
    add     r0, r0, r8
    str     r0, [sp, #0]             @ cend
    @ rep luma base: even -> rowbase (pixel 2s) ; odd -> rowbase+2third (pixel 160+2s)
    tst     r10, #1
    moveq   r0, r9
    addne   r0, r9, r8, lsl #1
    str     r0, [sp, #4]             @ repbase
Cpix:
    ldr     r6, [sp, #8]             @ cptr
    ldrb    r1, [r6]                 @ orig U
    ldrb    r2, [r6, #1]             @ orig V
    ldr     r0, [sp, #4]             @ repbase
    ldrb    r0, [r0]                 @ rep luma (already palette Y)
    mov     r3, #0
    mvn     r12, #0
    ldrb    r6, [r4, #0]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #1]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #2]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #0
    ldrb    r6, [r4, #3]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #4]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #5]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #3
    ldrb    r6, [r4, #6]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #7]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #8]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #6
    ldrb    r6, [r4, #9]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #10]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #11]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #9
    ldrb    r6, [r4, #12]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #13]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #14]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #12
    ldrb    r6, [r4, #15]
    subs    r6, r0, r6
    rsbmi   r6, r6, #0
    mov     lr, r6
    ldrb    r6, [r4, #16]
    subs    r6, r1, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    ldrb    r6, [r4, #17]
    subs    r6, r2, r6
    rsbmi   r6, r6, #0
    add     lr, lr, r6
    cmp     lr, r12
    movlo   r12, lr
    movlo   r3, #15
    ldr     r6, [sp, #8]
    ldrb    r0, [r4, r3]             @ (unused Y) -> skip; load U,V
    add     r1, r4, r3
    ldrb    r0, [r1, #1]             @ palette U
    strb    r0, [r6]
    ldrb    r0, [r1, #2]             @ palette V
    strb    r0, [r6, #1]
    add     r6, r6, #2
    str     r6, [sp, #8]
    ldr     r0, [sp, #4]
    add     r0, r0, #2
    str     r0, [sp, #4]
    ldr     r0, [sp, #0]
    cmp     r6, r0
    blo     Cpix
    add     r10, r10, #1
    add     r9, r9, r7
    add     r1, r5, r7, lsl #6
    cmp     r9, r1
    blo     Crow
    @ cache clean 2*STRIP
    mov     r0, r5
    mov     r1, r7, lsl #6
    mov     lr, pc
    b       CACHE_CLEAN
    add     sp, sp, #16
hret:
    pop     {r4-r11, lr}
    str     lr, [sp, #-4]!
    b       RESUME
    .ltorg

    .org    0xbb180
BAYER:
    .byte 0, 8, 2, 10
    .byte 12, 4, 14, 6
    .byte 3, 11, 1, 9
    .byte 15, 7, 13, 5
    .align 2
    .org    0xbb1a0
PAL_IDX:
    .byte 6, 0, 0, 0
PALETTES:
    .byte 30, 144, 125, 115, 114, 206, 164, 72, 183, 125, 148, 69, 225, 109, 139, 255, 128, 128   @ riso6
    .byte 82, 137, 113, 235, 103, 135, 167, 76, 160, 85, 108, 177, 39, 120, 153, 39, 120, 153   @ dark_sunset
    .byte 130, 105, 196, 198, 58, 159, 164, 77, 110, 131, 174, 87, 108, 162, 138, 108, 162, 138   @ vibrant_summer
    .byte 187, 57, 166, 138, 74, 190, 106, 130, 216, 88, 196, 152, 127, 192, 90, 127, 192, 90   @ fiesta
    .byte 99, 105, 197, 89, 123, 106, 185, 114, 111, 235, 106, 132, 41, 118, 137, 41, 118, 137   @ vibrant_nature
    .byte 108, 138, 215, 83, 192, 155, 52, 187, 133, 103, 207, 108, 178, 159, 88, 178, 159, 88   @ bold_hues
    .byte 199, 145, 105, 128, 156, 89, 37, 145, 113, 193, 54, 162, 155, 65, 183, 155, 65, 183   @ refreshing
    .align 2

    .org    0xbb240
photo43:
    mov     r6, #320
    mov     r7, #240
    strh    r6, [r4, #14]
    strh    r7, [r4, #16]
    mov     r0, #1
    strb    r0, [r4, #4]
    mov     r0, #1440
    strh    r0, [r4, #6]
    strh    r9, [r4, #8]
    strh    r0, [r4, #10]
    strh    r9, [r4, #12]
    b       PHOTO_PATH
    .ltorg

    .org    0xbb2c0
idx_stub:
    ldr     r12, =PAL_IDX_ADDR
    ldrb    r0, [r12]
    add     r0, r0, #1
    cmp     r0, #NPAL
    movhs   r0, #0
    strb    r0, [r12]
    push    {r3, r4, r5, r6, r7, lr}
    b       RESUME187
    .ltorg
